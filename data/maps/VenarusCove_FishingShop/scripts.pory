mapscripts VenarusCove_FishingShop_MapScripts {}

script VenarusCove_FishingShop_EventScript_PokeMart {
	lock
	faceplayer

	message(gText_HowMayIServeYou)
	waitmessage

	pokemart(VenarusCove_Mart)

	msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)

	release
	end
}

mart VenarusCove_Mart {
	ITEM_NET_BALL
    ITEM_LURE_BALL
}

script VenarusCove_FishingShop_EventScript_Boy {
	lock
	faceplayer

	msgbox(format("I'm thinking about getting into fishing, I wonder if they have any good starter rods."), MSGBOX_AUTOCLOSE)

	release
	end
}