
// guide level 10

mapscripts Route102_MapScripts {}

script WindyMeadow_EventScript_Angela {
	lock
	faceplayer

	trainerbattle_single(TRAINER_WINDYMEADOW_ANGELA,
		format("Shot in the dark here, but are you ignored in large crowds?"),
		Angela_Lose
	)

	msgbox(Angela_Lose, MSGBOX_AUTOCLOSE)

	release
	end
}

text Angela_Lose {
	format("Do you know how to operate a pitman arm?")
}

script WindyMeadow_EventScript_Steven {
	lock
	faceplayer
	
	trainerbattle_single(TRAINER_WINDYMEADOW_STEVEN,
		format("I've just completed my bachelor's in piperidine opioids!"),
		Steven_Lose
	)

	release
	end
}

text Steven_Lose {
	format("Do let me know if you need any piperidine opioids produced!")
}

script WindyMeadow_EventScript_Winona {
	lock
	faceplayer
	
	trainerbattle_single(TRAINER_WINDYMEADOW_WINONA,
		format("Help me build up the strength to jump in the water!"),
		Winona_Lose
	)

	release
	end
}

text Winona_Lose {
	format("I don't know if I'm feel any more confident...")
}

script WindyMeadow_EventScript_Halston {
	lock
	faceplayer
	
	trainerbattle_single(TRAINER_WINDYMEADOW_HALSTON,
		format("Bug pokémon are kinda like land fish!"),
		Halston_Lose
	)

	release
	end
}

text Halston_Lose {
	format("I'm not sure what land fish means if I'm being honest.")
}

script WindyMeadow_EventScript_Jake {
	lock
	faceplayer
	
	trainerbattle_single(TRAINER_WINDYMEADOW_JAKE,
		format("I'm looking to get a new job."),
