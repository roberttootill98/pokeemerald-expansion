const ID_ATTENDEE = 1
const ID_RIVAL = 2
const ID_AIDE = 3
const ID_DAD = 4

const ID_POKEBALL_BULBASAUR = 5
const ID_POKEBALL_CHIMCHAR = 6
const ID_POKEBALL_MUDKIP = 7

const ID_GRUNT = 8

mapscripts SundaraVillage_ContestHall_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_SUNDARA_STATE, 2: SundaraVillage_ContestHall_EventScript_GetPokemon
    ]
}

script SundaraVillage_ContestHall_EventScript_GetPokemon {
    lock

    setvar(VAR_SUNDARA_STATE, 3)

    // walk to aide and dad
    applymovement(ID_RIVAL, GetPokemon_RivalWalkToPeople)
    applymovement(OBJ_EVENT_ID_PLAYER, GetPokemon_PlayerWalkToPeople)
    waitmovement(ID_RIVAL)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    msgbox(format("{RIVAL}: Don't worry guys I got them out of bed in time."))
    closemessage

    // aide and dad look up
    playse(SE_PIN)
    applymovement(ID_AIDE, GetPokemon_FaceUp)
    applymovement(ID_DAD, GetPokemon_FaceUp)
    waitmovement(ID_AIDE)
    waitmovement(ID_DAD)
	waitse
    
    msgbox(format("<AIDE>: Thanks mate, you got here just in time, I don't know how many more stories about cute Shuckles I could take."))
    closemessage

    playse(SE_PIN)
    applymovement(ID_DAD, GetPokemon_DadAnnoyed)
    waitmovement(ID_DAD)
	waitse

    msgbox(format("Dad: Hey, I hadn't even gotten to the one about that time in Larost Harbour yet!"))
    closemessage

    msgbox(format("<AIDE>: Are you ready to pick your first Pokémon?"))
    closemessage

    applymovement(ID_DAD, GetPokemon_DadAnnoyedDone)
    waitmovement(ID_DAD)
    
    msgbox(format("Dad: Make sure you pick something cute!"))
    closemessage

    playse(SE_PIN)
    applymovement(ID_DAD, GetPokemon_DadHeart)
    waitmovement(ID_DAD)
    waitse

    // walk aide to desk
    applymovement(ID_AIDE, GetPokemon_WorkAideToDesk)
    waitmovement(ID_AIDE)

    // player and rival face up
    applymovement(ID_RIVAL, GetPokemon_PeopleFaceUp)
    applymovement(OBJ_EVENT_ID_PLAYER, GetPokemon_PeopleFaceUp)
    waitmovement(ID_RIVAL)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    msgbox(format("<AIDE>: Please have a look inside each Poké ball and choose carefully."))
    closemessage

    release
    end
}

movement GetPokemon_RivalWalkToPeople {
    walk_up
    walk_right * 7
    face_down
}

movement GetPokemon_PlayerWalkToPeople {
    walk_up * 2
    walk_right * 6
    face_down
}

movement GetPokemon_FaceUp {
    face_up
    emote_exclamation_mark
}

movement GetPokemon_DadAnnoyed {
    face_right
    emote_exclamation_mark
}

movement GetPokemon_DadAnnoyedDone {
    face_up
}

movement GetPokemon_DadHeart {
    emote_heart
}

movement GetPokemon_WorkAideToDesk {
    walk_up * 3
    face_left
}

movement GetPokemon_PeopleFaceUp {
    face_up
}

script SundaraVillage_ContestHall_EventScript_Rival {
    lock
    faceplayer

    msgbox(format("I'm sure I'll train mine better, so you can pick first!"))
    closemessage

    release
    end
}

script SundaraVillage_ContestHall_EventScript_Aide {
    lock
    faceplayer

    msgbox(format("Please have a look inside each Poké ball and choose carefully."))
    closemessage

    release
    end
}

script SundaraVillage_ContestHall_EventScript_Dad {
    lock
    faceplayer

    switch(var(VAR_SUNDARA_STATE)) {
        case 3:
            msgbox(format("You could also pick a cool, clever, smart or beautiful Pokémon, but cute Pokémon are the best!"))
            closemessage
        case 4:
            msgbox(format("Have you and {RIVAL} found anything on (route 4) yet? That's north of Sundara Village."))
            closemessage
    }

    release
    end
}

script SundaraVillage_ContestHall_EventScript_Leave_Outside {
    lock

    msgbox(format("{RIVAL}: Hey {PLAYER}, where do you think you're going?"))
    closemessage

    applymovement(OBJ_EVENT_ID_PLAYER, GetPokemon_Leave_Outside)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    release
    end
}

movement GetPokemon_Leave_Outside {
    walk_up
}

script SundaraVillage_ContestHall_EventScript_Leave_ContestHall {
    lock

    msgbox(format("{RIVAL}: Hey {PLAYER}, where do you think you're going?"))
    closemessage

    applymovement(OBJ_EVENT_ID_PLAYER, GetPokemon_Leave_ContestHall)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    release
    end
}

movement GetPokemon_Leave_ContestHall {
    walk_down
}

script SundaraVillage_ContestHall_EventScript_PokeBall_Bulbasaur {
    lock

    showmonpic(SPECIES_BULBASAUR, 10, 3)
    playmoncry(SPECIES_BULBASAUR, 0)

    msgbox(format("It's Bulbasaur, the nefarious tyke!"))
    closemessage

    msgbox(format("Do you want to choose Bulbasaur?"), MSGBOX_YESNO)
    
    if(var(VAR_RESULT)) {
        setvar(VAR_STARTER_MON, 0)
        call(SundaraVillage_ContestHall_EventScript_ObtainPokemon)
    } else {
        hidemonpic
    }

    release
    end
}

script SundaraVillage_ContestHall_EventScript_PokeBall_Chimchar {
    lock

    showmonpic(SPECIES_CHIMCHAR, 10, 3)
    playmoncry(SPECIES_CHIMCHAR, 0)

    msgbox(format("It's Chimchar, the nefarious tyke!"))
    closemessage

    msgbox(format("Do you want to choose Chimchar?"), MSGBOX_YESNO)
    
    if(var(VAR_RESULT)) {
        setvar(VAR_STARTER_MON, 1)
        call(SundaraVillage_ContestHall_EventScript_ObtainPokemon)
    } else {
        hidemonpic
    }

    release
    end
}

script SundaraVillage_ContestHall_EventScript_PokeBall_Mudkip {
    lock

    showmonpic(SPECIES_MUDKIP, 10, 3)
    playmoncry(SPECIES_MUDKIP, 0)

    msgbox(format("It's Mudkip, the nefarious tyke!"))
    closemessage

    msgbox(format("Do you want to choose Mudkip?"), MSGBOX_YESNO)
    
    if(var(VAR_RESULT)) {
        setvar(VAR_STARTER_MON, 2)        
        call(SundaraVillage_ContestHall_EventScript_ObtainPokemon)
    } else {
        hidemonpic
    }

    release
    end
}

script SundaraVillage_ContestHall_EventScript_ObtainPokemon {
    setvar(VAR_SUNDARA_STATE, 4)

    hidemonpic

    playfanfare(MUS_RG_CAUGHT)

    switch(var(VAR_STARTER_MON)) {
        case 0:
            removeobject(ID_POKEBALL_BULBASAUR)
        
            msgbox(format("{PLAYER} received Bulbasaur!"))
        
            givemon(SPECIES_BULBASAUR, 5, ITEM_NONE)
            setflag(FLAG_SUNDARA_GET_POKEMON_POKEBALL_BULBASAUR)
        case 1:
            removeobject(ID_POKEBALL_CHIMCHAR)
        
            msgbox(format("{PLAYER} received Chimchar!"))

            givemon(SPECIES_CHIMCHAR, 5, ITEM_NONE)
            setflag(FLAG_SUNDARA_GET_POKEMON_POKEBALL_CHIMCHAR)
        case 2:
            removeobject(ID_POKEBALL_MUDKIP)
        
            msgbox(format("{PLAYER} received Mudkip!"))

            givemon(SPECIES_MUDKIP, 5, ITEM_NONE)
            setflag(FLAG_SUNDARA_GET_POKEMON_POKEBALL_MUDKIP)
    }

    closemessage
    waitfanfare

    // enable pokemon start menu item
    setflag(FLAG_SYS_POKEMON_GET)

    // rival get pokemon
    switch(var(VAR_STARTER_MON)) {
        case 0:
            applymovement(ID_RIVAL, ObtainPokemon_Rival_Chimchar)
            waitmovement(ID_RIVAL)

            removeobject(ID_POKEBALL_CHIMCHAR)
        case 1:
            applymovement(ID_RIVAL, ObtainPokemon_Rival_Mudkip)
            waitmovement(ID_RIVAL)

            removeobject(ID_POKEBALL_MUDKIP)
        case 2:
            applymovement(ID_RIVAL, ObtainPokemon_Rival_Bulbasaur)
            waitmovement(ID_RIVAL)

            removeobject(ID_POKEBALL_BULBASAUR)
    }

    msgbox(format("I'll take this one then!"))
    closemessage

    // give pokedex
    call(SundaraVillage_ContestHall_EventScript_GivePokedexAndBalls)

    // grunt event
    call(SundaraVillage_ContentHall_EventScript_Grunt)

    // after grunt event
    call(SundaraVillage_ContestHall_EventScript_AfterGrunt)

    return
}

movement ObtainPokemon_Rival_Chimchar {
    walk_left
    walk_up * 2
}

movement ObtainPokemon_Rival_Mudkip {
    walk_up * 2
}

movement ObtainPokemon_Rival_Bulbasaur {
    walk_left * 2
    walk_up * 2
}

script SundaraVillage_ContestHall_EventScript_GivePokedexAndBalls {
    msgbox(format("<AIDE>: And here's your Pokédexes and Poké balls!"))
    closemessage

    switch(var(VAR_STARTER_MON)) {
        case 0:
            applymovement(ID_AIDE, GivePokedex_Rival_Bulbasaur)
            waitmovement(ID_AIDE)

            applymovement(ID_RIVAL, GivePokedex_Rival)
            waitmovement(ID_RIVAL)

            delay(60)
        case 1:
            applymovement(ID_AIDE, GivePokedex_Rival_Chimchar)
            waitmovement(ID_AIDE)

            applymovement(ID_RIVAL, GivePokedex_Rival)
            waitmovement(ID_RIVAL)

            delay(60)
    }

    switch(var(VAR_STARTER_MON)) {
        case 0:
            applymovement(ID_AIDE, GivePokedex_Bulbasaur)
            waitmovement(ID_AIDE)
        case 1:
            applymovement(ID_AIDE, GivePokedex_Chimchar)
            waitmovement(ID_AIDE)
        case 2:
            applymovement(ID_AIDE, GivePokedex_Mudkip)
            waitmovement(ID_AIDE)
    }

    applymovement(OBJ_EVENT_ID_PLAYER, GivePokedex_Player)
    waitmovement(OBJ_EVENT_ID_PLAYER)

    playfanfare(MUS_RG_CAUGHT)
    msgbox(format("{PLAYER} received the Pokédex!"))
    closemessage
    waitfanfare

    setflag(FLAG_SYS_POKEDEX_GET)

    giveitem(ITEM_POKE_BALL, 5)
    closemessage

    if(var(VAR_STARTER_MON) == 2) {
        applymovement(ID_AIDE, GivePokedex_Rival_Mudkip)
        waitmovement(ID_AIDE)

        applymovement(ID_RIVAL, GivePokedex_Rival)
        waitmovement(ID_RIVAL)

        delay(60)
    }    

    return
}

movement GivePokedex_Bulbasaur {
    walk_left
    face_up
}

movement GivePokedex_Chimchar {
    walk_left
    face_up
}

movement GivePokedex_Mudkip {
    walk_left
    face_up
}

movement GivePokedex_Player {
    face_down
}

movement GivePokedex_Rival_Chimchar {
    walk_left
    face_up
}

movement GivePokedex_Rival_Mudkip {
    walk_left * 2
    face_up
}

movement GivePokedex_Rival_Bulbasaur {
    walk_left * 2
    face_up
}

movement GivePokedex_Rival {
    face_down
}

script SundaraVillage_ContentHall_EventScript_Grunt {
    // unhide grunt
    addobject(ID_GRUNT)

    // play music
    playbgm(MUS_ENCOUNTER_AQUA, 0)

    // grunt looks around
    applymovement(ID_GRUNT, Grunt_Enter)
    waitmovement(ID_GRUNT)

    playse(SE_PIN)
    applymovement(ID_GRUNT, Grunt_Enter_Question)
    waitmovement(ID_GRUNT)
    waitse

    msgbox(format("Hey what's going on here!"))
    closemessage

    playse(SE_PIN)

    applymovement(ID_ATTENDEE, Attendee_Exclame)
    applymovement(OBJ_EVENT_ID_PLAYER, Grunt_AllFace)
    applymovement(ID_RIVAL, Grunt_AllFace)
    applymovement(ID_AIDE, Grunt_AllFace)
    applymovement(ID_DAD, Grunt_AllFace)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    waitmovement(ID_RIVAL)
    waitmovement(ID_AIDE)
    waitmovement(ID_DAD)

    waitse

    applymovement(ID_GRUNT, Grunt_LookAround)
    waitmovement(ID_GRUNT)

    delay(15)
    applymovement(ID_GRUNT, Grunt_LookUp)
    waitmovement(ID_GRUNT)

    delay(15)
    applymovement(ID_GRUNT, Grunt_LookDown)
    waitmovement(ID_GRUNT)

    delay(15)
    playse(SE_PIN)
    applymovement(ID_GRUNT, Grunt_Exclame)
    waitmovement(ID_GRUNT)
    waitse

    msgbox(format("Are you giving out Pokémon?\nI'll just take this one then!"))
    closemessage

    applymovement(ID_GRUNT, Grunt_TakePokemon_DadFaceUp)
    waitmovement(ID_GRUNT)

    // take pokemon
    switch(var(VAR_STARTER_MON)) {
        case 0:
            applymovement(ID_GRUNT, Grunt_TakePokemon_Mudkip_Start)
            waitmovement(ID_GRUNT)

            msgbox(format("Get out of my way!"))
            closemessage

            playse(SE_WALL_HIT)

            applymovement(ID_GRUNT, Grunt_TakePokemon_Mudkip_Shove)
            applymovement(ID_AIDE, Grunt_TakePokemon_Shove_Aide)
            waitmovement(ID_GRUNT)
            waitmovement(ID_AIDE)

            waitse

            applymovement(ID_GRUNT, Grunt_TakePokemon_Mudkip_End)
            waitmovement(ID_GRUNT)

            removeobject(ID_POKEBALL_MUDKIP)
        case 1:
            applymovement(ID_GRUNT, Grunt_TakePokemon_Bulbasaur)
            waitmovement(ID_GRUNT)

            removeobject(ID_POKEBALL_BULBASAUR)
        case 2:
            applymovement(ID_GRUNT, Grunt_TakePokemon_Chimchar_Start)
            waitmovement(ID_GRUNT)

            msgbox(format("Get out of my way!"))
            closemessage

            playse(SE_WALL_HIT)

            applymovement(ID_GRUNT, Grunt_TakePokemon_Chimchar_Shove)
            applymovement(ID_AIDE, Grunt_TakePokemon_Shove_Aide)
            waitmovement(ID_GRUNT)
            waitmovement(ID_AIDE)

            waitse

            applymovement(ID_GRUNT, Grunt_TakePokemon_Chimchar_End)
            waitmovement(ID_GRUNT)

            removeobject(ID_POKEBALL_CHIMCHAR)
    }

    applymovement(ID_AIDE, Aide_Exclame)
    waitmovement(ID_AIDE)

    msgbox(format("<AIDE>: Hey that's not yours!"))
    closemessage

    msgbox(format("See ya later losers!"))
    closemessage

    // grunt leave
    switch(var(VAR_STARTER_MON)) {
        case 0:
            applymovement(ID_GRUNT, Grunt_TakePokemon_Leave_Mudkip)
            waitmovement(ID_GRUNT)
        case 1:
            applymovement(ID_GRUNT, Grunt_TakePokemon_Leave_Bulbasaur)
            waitmovement(ID_GRUNT)
        case 2:
            applymovement(ID_GRUNT, Grunt_TakePokemon_Leave_Chimchar)
            waitmovement(ID_GRUNT)
    }

    applymovement(ID_GRUNT, Grunt_TakePokemon_Leave_End)
    applymovement(ID_AIDE, Grunt_TakePokemon_Leave_AllFace)
    applymovement(ID_DAD, Grunt_TakePokemon_Leave_AllFace)
    waitmovement(ID_AIDE)
    waitmovement(ID_DAD)
    waitmovement(ID_GRUNT)

    delay(15)
    playse(SE_SLIDING_DOOR)
    removeobject(ID_GRUNT)
	waitse

    playbgm(MUS_VERDANTURF, 0)

    return
}

