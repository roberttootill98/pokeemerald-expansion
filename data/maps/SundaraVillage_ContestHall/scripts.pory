script SundaraVillage_ContestHall_EventScript_AfterGrunt {
    applymovement(OBJ_EVENT_ID_PLAYER, AfterGrunt_FaceDown)
    applymovement(ID_RIVAL, AfterGrunt_FaceDown)
    applymovement(ID_AIDE, AfterGrunt_FaceDown)
    applymovement(ID_DAD, AfterGrunt_FaceUp)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    waitmovement(ID_RIVAL)
    waitmovement(ID_AIDE)
    waitmovement(ID_DAD)

    msgbox(format("<AIDE>: What are we going to do? I was supposed to be getting my first Pokémon today too..."))
    closemessage

    msgbox(format("Dad: Come sit down guys."))
    closemessage

    applymovement(ID_DAD, AfterGrunt_FaceRight)
    waitmovement(ID_DAD)
    
    switch(var(VAR_STARTER_MON)) {
        case 0:
            applymovement(OBJ_EVENT_ID_PLAYER, AfterGrunt_Sit_Player_Bulbasaur)
            applymovement(ID_RIVAL, AfterGrunt_Sit_Rival_Bulbasaur)
            applymovement(ID_AIDE, AfterGrunt_Sit_Aide_Bulbasaur)
        case 1:
            applymovement(OBJ_EVENT_ID_PLAYER, AfterGrunt_Sit_Player_Chimchar)
            applymovement(ID_RIVAL, AfterGrunt_Sit_Rival_Chimchar)
            applymovement(ID_AIDE, AfterGrunt_Sit_Aide_Chimchar)
        case 2:
            applymovement(OBJ_EVENT_ID_PLAYER, AfterGrunt_Sit_Player_Mudkip)
            applymovement(ID_RIVAL, AfterGrunt_Sit_Rival_Mudkip)
            applymovement(ID_AIDE, AfterGrunt_Sit_Aide_Mudkip)
    }

    waitmovement(OBJ_EVENT_ID_PLAYER)
    waitmovement(ID_RIVAL)
    waitmovement(ID_AIDE)

    playse(MUS_ABANDONED_SHIP)
    waitse

    msgbox(format("Dad: If we act quickly we can stop that guy from getting away!"))
    closemessage
    msgbox(format("<AIDE>, since you don't have a Pokémon you stay in town and stop anyone going into Ferre Grasslands to the east."))
    closemessage
    msgbox(format("{RIVAL} and {PLAYER} you guys take your new Pokémon and check out (route 4) to the north! We can do this everyone!"))
    closemessage

    msgbox(format("<AIDE>: Thanks sir, let's go everyone!"))
    closemessage

    // people leave
    applymovement(ID_RIVAL, AfterGrunt_Leave_Rival)
    applymovement(ID_AIDE, AfterGrunt_Leave_Aide)
    waitmovement(ID_RIVAL)
    waitmovement(ID_AIDE)

    delay(15)
    playse(SE_SLIDING_DOOR)
    removeobject(ID_RIVAL)
	waitse

    applymovement(ID_AIDE, AfterGrunt_Leave_Aide_Exit)
    waitmovement(ID_AIDE)

    delay(15)
    playse(SE_SLIDING_DOOR)
    removeobject(ID_AIDE)
	waitse

    return
}

