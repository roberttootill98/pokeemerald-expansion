const ID_MUM = 1

mapscripts LittlerootTown_BrendansHouse_1F_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_SUNDARA_STATE, 0: SundaraVillage_PlayerHouse_1F_EventScript_WalkDownstairs
	]
}

script SundaraVillage_PlayerHouse_1F_EventScript_WalkDownstairs {
	lock

	call(SetGameStart)

	// mum exclamation mark
	playse(SE_PIN)
	applymovement(ID_MUM, mumExclamationMark)
	waitmovement(ID_MUM)
	waitse

	msgbox(format("Hey {PLAYER}!"))
	closemessage

	// wait
	delay(15)

	// move mum to player
	applymovement(ID_MUM, mumMoveToPlayer)
	waitmovement(ID_MUM)

	msgbox(format("You're up late, what time do you call this?"))
	closemessage

	// set clock event
	fadescreen(FADE_TO_BLACK)
	special(StartWallClock)
	waitstate

	msgbox(format("Isn't today the day <AIDE> arrives with her Pokémon? Don't forget these!"))
	closemessage

	// give running shoes
	call(giveRunningShoes)

	// walk mum away a bit
	applymovement(ID_MUM, mumWalkAwayABit)
	waitmovement(ID_MUM)

	msgbox(format("Also I think {RIVAL} is outside, you probably ought to say hello."))
	closemessage

	// move mum back to table
	applymovement(ID_MUM, mumBackToTable)
	waitmovement(ID_MUM)

	setvar(VAR_SUNDARA_STATE, 1)
	
	release
	end
}

// sets all vars and flags that have non-default value
script SetGameStart {
	setflag(FLAG_SUNDARA_GET_POKEMON_GRUNT)
	setflag(FLAG_ROUTE4_LOST_POKEMON)
	setflag(FLAG_SUNDARA_RETURN_STOLEN_POKEMON)
}

movement mumExclamationMark {
	emote_exclamation_mark
}

movement mumMoveToPlayer {
	walk_up
	walk_right * 6
	walk_up
}

movement mumWalkAwayABit {
	walk_down
	walk_left
	face_up
}

movement mumBackToTable {
	walk_left * 5
	walk_down
	face_right
}

script giveRunningShoes {
	playfanfare(MUS_OBTAIN_ITEM)

	msgbox(format("{PLAYER} put on the running shoes!"))
	closemessage

	waitfanfare()

	setflag(FLAG_RECEIVED_RUNNING_SHOES)

	return
}

script SundaraVillage_PlayerHouse_1F_EventScript_Mum {
	lock
	faceplayer

	switch(var(VAR_SUNDARA_STATE)) {
		case 1:
			msgbox(format("You really ought to go see {RIVAL}, they're mucking up the window."))
		case 4:
			msgbox(format("Are you ok {PLAYER}? I heard about that rotten fella stealing that poor Pokémon. I haven't seen him here at least!"))
		case 6:
			msgbox(format("Hey {PLAYER}, how are you? I've been thinking about clouds recently."))
	}

	closemessage

	release
	end
}