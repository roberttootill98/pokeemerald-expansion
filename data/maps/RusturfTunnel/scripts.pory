// guide level 7

mapscripts RusturfTunnel_MapScripts {}

script LakeApise_GiveSootheBell {
	lock
	faceplayer

	if(flag(FLAG_LAKEAPISE_GIVE_SOOTHEBELL)) {
		msgbox(format("Lake Apise must be the most soothing place in all of <REGION>."))
		closemessage
	} else {
		msgbox(format("Lake Apise is really soothing at this time of day.\p...\pTake this."))
		closemessage

		giveitem(ITEM_SOOTHE_BELL)

		setflag(FLAG_LAKEAPISE_GIVE_SOOTHEBELL)
	}

	release
	end
}

script LakeApise_Trainer_Annabelle {
	trainerbattle_single(TRAINER_LAKEAPISE_ANNABELLE,
		format(""),
		format("")
	)

	msgbox(format(""), MSGBOX_AUTOCLOSE)

	end
}

script LakeApise_Item_NestBall {
	finditem(ITEM_NEST_BALL)
	end
}