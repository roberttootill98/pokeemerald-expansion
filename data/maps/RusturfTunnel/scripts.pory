// guide level 7

mapscripts RusturfTunnel_MapScripts {}

script LakeApise_GiveSootheBell {
	lock
	faceplayer

	if(flag(FLAG_LAKEAPISE_GIVE_SOOTHEBELL)) {
		msgbox(format("Lake Apise must be the most soothing place in all of <REGION>."))
		closemessage
	} else {
		msgbox(format("Lake Apise is really soothing at this time of day.\p...\pTake this."))
		closemessage

		giveitem(ITEM_SOOTHE_BELL)

		setflag(FLAG_LAKEAPISE_GIVE_SOOTHEBELL)
	}

	release
	end
}

script LakeApise_Trainer_Annabelle {
	trainerbattle_single(TRAINER_LAKEAPISE_ANNABELLE,
		format("The smell of the breeze is different out here!"),
		format("You odour is quite unique!")
	)

	msgbox(format("You odour is quite unique!"), MSGBOX_AUTOCLOSE)

	end
}

script LakeApise_Trainer_Christian {
	trainerbattle_single(TRAINER_LAKEAPISE_CHRISTIAN,
		format("I've been practising my moves by cutting this grass!"),
		format("Maybe I would have been better suited practising my battling skills!")
	)

	msgbox(format("Maybe I would have been better suited practising my battling skills!"), MSGBOX_AUTOCLOSE)

	end
}

script LakeApise_Trainer_Dunga {
	trainerbattle_single(TRAINER_LAKEAPISE_DUNGA,
		format("I've heard there are some extremely rare pokémon here!"),
		format("Your pokémon seem like quite rare specimens!")
	)

	msgbox(format("Your pokémon seem like quite rare specimens!"), MSGBOX_AUTOCLOSE)

	end
}

script LakeApise_Trainer_Fingle {
	trainerbattle_single(TRAINER_LAKEAPISE_FINGLE,
		format("I ain't finding nothing in this here Lake, fancy a battle?"),
		format("Fishing sure is a grind, got me wonderin' if I'm the one on the hook.")
	)

	msgbox(format("Fishing sure is a grind, got me wonderin' if I'm the one on the hook."), MSGBOX_AUTOCLOSE)

	end
}

script LakeApise_Item_NestBall {
	finditem(ITEM_NEST_BALL)
	end
}