const ID_GRUNT = 1
const ID_LOST_POKEMON = 2

mapscripts Route104_MapScripts {}

script Route4_EventScript_Grunt {
	lockall
	
	msgbox(format("Oh boy I never considered that I might have to swim when I joined <EVILTEAM>..."))
	closemessage

	playse(SE_PIN)
	faceplayer
	applymovement(ID_GRUNT, Route4_Grunt_Exclame)
	waitmovement(ID_GRUNT)
	waitse

	msgbox(format("Wait you're back? I guess I'll have to show you how to battle now!"))
	closemessage

	switch(var(VAR_STARTER_MON)) {
        case 0:
			trainerbattle_no_intro(TRAINER_ROUTE4_GRUNT_MUDKIP, format("I hate losing, like winning hates me!"))
        case 1:
			trainerbattle_no_intro(TRAINER_ROUTE4_GRUNT_BULBASAUR, format("I hate losing, like winning hates me!"))
        case 2:
			trainerbattle_no_intro(TRAINER_ROUTE4_GRUNT_CHIMCHAR, format("I hate losing, like winning hates me!"))
    }

	msgbox(format("This Pokémon doesn't seem strong anyway! I gotta zip!"))
	closemessage

	// replace grunt with item poke ball
	fadescreen(FADE_TO_BLACK)
	playse(SE_M_DIVE)
	removeobject(ID_GRUNT)
	addobject(ID_LOST_POKEMON)
	waitse
	fadescreen(FADE_FROM_BLACK)

	setflag(FLAG_ROUTE4_GRUNT)
	setvar(VAR_SUNDARA_STATE, 5)

	releaseall
	end
}

movement Route4_Grunt_Exclame {
	emote_exclamation_mark
}

