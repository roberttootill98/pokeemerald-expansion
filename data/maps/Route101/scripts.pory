// guide level = 6

mapscripts Route101_MapScripts {}

script FerreGrasslands_Trainer_Michelle {
	trainerbattle_single(TRAINER_FERREGRASSLANDS_MICHELLE,
		format("Do you have strong Pokémon?"),
		format("My Pokémon will be as strong as yours soon!")
	)

	msgbox(format("My Pokémon will be as strong as yours soon!"), MSGBOX_AUTOCLOSE)

	end
}

script FerreGrasslands_Trainer_Mikey {
	trainerbattle_single(TRAINER_FERREGRASSLANDS_MIKEY,
		format("Are you going to Lake Apise?"),
		format("I never stood a chance!")
	)

	msgbox(format("I've heard there's a rare Pokémon at Lake Apise!"), MSGBOX_AUTOCLOSE)

	end
}

script FerreGrasslands_Trainer_Nick {
	trainerbattle_single(TRAINER_FERREGRASSLANDS_NICK,
		format("What's your rarest Pokémon?"),
		format("There's so many Pokémon to see!")
	)

	msgbox(format("There's so many rare Pokémon to see!"), MSGBOX_AUTOCLOSE)

	end
}