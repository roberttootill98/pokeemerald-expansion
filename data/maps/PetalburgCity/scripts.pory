const ID_RIVAL = 1
const ID_AIDE_EXIT = 2
const ID_AIDE_RETURN_STOLEN_POKEMON = 3
const ID_DAD_RETURN_STOLEN_POKEMON = 4
const ID_RIVAL_RETURN_STOLEN_POKEMON = 5

mapscripts PetalburgCity_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_SUNDARA_STATE, 1: SundaraVillage_EventScript_RivalOutsideHouse
		VAR_SUNDARA_STATE, 5: SundaraVillage_EventScript_ReturnStolenPokemon
	]
}

script SundaraVillage_EventScript_RivalOutsideHouse {
	lock
	
	setvar(VAR_SUNDARA_STATE, 2)
	setflag(FLAG_SUNDARA_RIVAL_OUTISDE_HOUSE)

	applymovement(OBJ_EVENT_ID_PLAYER, rivalOutsideHousePlayer)
	waitmovement(OBJ_EVENT_ID_PLAYER)

	playse(SE_PIN)
	applymovement(ID_RIVAL, rivalOutsideHouse)
	waitmovement(ID_RIVAL)
	waitse

	msgbox(format("I wasn't looking at your mum! Anyways! Let's go see if <AIDE> is down at the content hall yet!"))
	closemessage

	// walk to contest hall
	applymovement(ID_RIVAL, rivalWalkToContestHall)
	applymovement(OBJ_EVENT_ID_PLAYER, rivalWalkToContestHallPlayer)
	waitmovement(ID_RIVAL)
	waitmovement(OBJ_EVENT_ID_PLAYER)

	// exclamation mark
	playse(SE_PIN)
	applymovement(ID_RIVAL, rivalWalkToContestHallLookInside)
	waitmovement(ID_RIVAL)
	waitse

	msgbox(format("I can see them through the window! Quick! Let's go inside!"))
	closemessage

	// rival enter contest hall
	applymovement(ID_RIVAL, rivalWalkToContentHallRivalInFrontOfDoor)
	waitmovement(ID_RIVAL)

	opendoor(21, 17)
	playse(SE_SLIDING_DOOR)
	waitdooranim()
	waitse

	removeobject(ID_RIVAL)
	playse(SE_EXIT)
	waitse

	// player enter contest hall
	applymovement(OBJ_EVENT_ID_PLAYER, rivalWalkToContentHallPlayerInFrontOfDoor)
	waitmovement(OBJ_EVENT_ID_PLAYER)

	warp(MAP_SUNDARA_VILLAGE_CONTEST_HALL, 1, 0, 0)
}

movement rivalOutsideHousePlayer {
	face_right
}

movement rivalOutsideHouse {
	emote_exclamation_mark
	face_left
}

movement rivalWalkToContestHall {
	player_run_down
	player_run_right * 19
	player_run_down
	player_run_right * 2
	player_run_down * 2
	player_run_right
	player_run_down * 8
	player_run_left
	player_run_down
	player_run_left * 14
	face_up
}

movement rivalWalkToContestHallPlayer {
	player_run_right
	player_run_down
	player_run_right * 19
	player_run_down
	player_run_right * 2
	player_run_down * 2
	player_run_right
	player_run_down * 8
	player_run_left
	player_run_down
	player_run_left * 13
	face_left
}

movement rivalWalkToContestHallLookInside {
	emote_exclamation_mark
}

movement rivalWalkToContentHallRivalInFrontOfDoor {
	walk_left
	face_up
}

movement rivalWalkToContentHallPlayerInFrontOfDoor {
	walk_left * 2
	face_up
}

script SundaraVillage_EventScript_AideStopLeave {
	lockall
	
	applymovement(ID_AIDE_EXIT, AideStopLeave_FaceLeft)
	waitmovement(ID_AIDE_EXIT)

	msgbox(format("Hey {PLAYER}, have you found that guy yet? I haven't seem him come this way!"))
	closemessage

	applymovement(OBJ_EVENT_ID_PLAYER, AideStopLeave_MovePlayer)
	waitmovement(OBJ_EVENT_ID_PLAYER)
	
	releaseall
	end
}

movement AideStopLeave_FaceLeft {
	face_left
}

movement AideStopLeave_MovePlayer {
	walk_left
}

script SundaraVillage_EventScript_ReturnStolenPokemon {
	lockall

	setvar(VAR_SUNDARA_STATE, 6)

	switch(var(VAR_STARTER_MON)) {
        case 0:
			msgbox(format("<AIDE>: Thank you so much for saving Mudkip!"))
        case 1:
			msgbox(format("<AIDE>: Thank you so much for saving Bulbasaur!"))
        case 2:
			msgbox(format("<AIDE>: Thank you so much for saving Chimchar!"))
    }

	closemessage

	msgbox(format("Dad: What are you guys going to do now?"))
	closemessage

	msgbox(format("{RIVAL}: I'm off to find the strongest Pokémon!"))
	closemessage

	applymovement(ID_RIVAL_RETURN_STOLEN_POKEMON, SundaraVillage_ReturnStolenPokemon_RivalLeave)
	waitmovement(ID_RIVAL_RETURN_STOLEN_POKEMON)
	removeobject(ID_RIVAL_RETURN_STOLEN_POKEMON)

	msgbox(format("<AIDE>: I'm going to find my way back to the capital to share my findings with <PROFESSOR>"))
	closemessage

	applymovement(ID_AIDE_RETURN_STOLEN_POKEMON, SundaraVillage_ReturnStolenPokemon_AideLeave)
	waitmovement(ID_AIDE_RETURN_STOLEN_POKEMON)
	removeobject(ID_AIDE_RETURN_STOLEN_POKEMON)

	playse(SE_PIN)
	applymovement(ID_DAD_RETURN_STOLEN_POKEMON, SundaraVillage_ReturnStolenPokemon_DadHeart)
	waitmovement(ID_DAD_RETURN_STOLEN_POKEMON)
	waitse
	
	msgbox(format("Dad: Well done today {PLAYER}."))
	closemessage

	applymovement(ID_DAD_RETURN_STOLEN_POKEMON, SundaraVillage_ReturnStolenPokemon_DadLeave)
	waitmovement(ID_DAD_RETURN_STOLEN_POKEMON)
	removeobject(ID_DAD_RETURN_STOLEN_POKEMON)

	setflag(FLAG_SUNDARA_RETURN_STOLEN_POKEMON)

	releaseall
	end
}

movement SundaraVillage_ReturnStolenPokemon_RivalLeave {
	player_run_right * 2
	player_run_up
	player_run_right * 5
}

movement SundaraVillage_ReturnStolenPokemon_AideLeave {
	walk_right * 2
	walk_up
	walk_right * 2
	walk_up
	walk_right * 4
}

movement SundaraVillage_ReturnStolenPokemon_DadHeart {
	emote_heart
}

movement SundaraVillage_ReturnStolenPokemon_DadLeave {
	walk_left * 8
}