
mapscripts MauvilleCity_PokemonCenter_1F_MapScripts {}

raw `
.set LOCALID_NURSE, 1

MauvilleCity_PokemonCenter_1F_EventScript_Nurse:: @ 8210E78
	setvar VAR_0x800B, LOCALID_NURSE
	call Common_EventScript_PkmnCenterNurse
	waitmessage
	waitbuttonpress
	release
	end

`

script VenarusCove_EventScript_PokeMart {
	lock
	faceplayer

	message(gText_HowMayIServeYou)
	waitmessage

	pokemart(VenarusCove_Mart)

	msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)

	release
	end
}

mart VenarusCove_Mart {
	ITEM_POKE_BALL
	ITEM_POTION
	ITEM_ANTIDOTE
	ITEM_PARALYZE_HEAL
	ITEM_REPEL
}

script VenarusCove_EventScript_PokemonCenter_1F_Camper {
	lock
	faceplayer

	msgbox(format("I heard the mart employee complaining on his break. He said they're losing out to the fishing shop."), MSGBOX_AUTOCLOSE)

	release
	end
}

script VenarusCove_EventScript_PokemonCenter_1F_Woman {
	lock
	faceplayer

	msgbox(format("I have a really hard time telling what the nurse is saying, I think it's something about the room acoustics."), MSGBOX_AUTOCLOSE)

	release
	end
}

