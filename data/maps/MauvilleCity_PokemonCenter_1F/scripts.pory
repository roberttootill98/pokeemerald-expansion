
mapscripts MauvilleCity_PokemonCenter_1F_MapScripts {}

raw `
.set LOCALID_NURSE, 1

MauvilleCity_PokemonCenter_1F_EventScript_Nurse:: @ 8210E78
	setvar VAR_0x800B, LOCALID_NURSE
	call Common_EventScript_PkmnCenterNurse
	waitmessage
	waitbuttonpress
	release
	end

`

script VenarusCove_EventScript_PokeMart {
	lock
	faceplayer

	message(gText_HowMayIServeYou)
	waitmessage

	pokemart(VenarusCove_Mart)

	msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)

	release
	end
}

mart VenarusCove_Mart {
	ITEM_LAVA_COOKIE
	ITEM_MOOMOO_MILK
	ITEM_RARE_CANDY
	ITEM_LEMONADE
	ITEM_BERRY_JUICE
}
