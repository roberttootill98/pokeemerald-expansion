
mapscripts SlateportCity_MapScripts {}

const ID_RIVAL = 2

script ApiseVillage_EventScript_Grandma {
	lock
	faceplayer

	msgbox(format("Grandma: Hello my dear {PLAYER}. Here in Apise Village, we have honey gardens, they create very clear air. It can even restore the health of Pokémon, try stepping in the middle of those flowers!"))
	closemessage

	release
	end
}

script ApiseVillage_EventScript_HealSpot {
	lock

	fadescreen(FADE_TO_BLACK)
	playse(MUS_HEAL)
	special(HealPlayerParty)
	waitse
	fadescreen(FADE_FROM_BLACK)
	
	msgbox(format("{PLAYER}'s Pokémon were healed completely!"))
	closemessage

	release
	end
}

script ApiseVillage_EventScript_RivalBattle {
	lock

	// look at player
	playse(SE_PIN)
	applymovement(ID_RIVAL, ApiseVillage_Movement_RivalSee)
	waitmovement(ID_RIVAL)
	waitse

	// say hello
	msgbox(format("Hey {PLAYER}!"))
	closemessage

	// walk to player
	applymovement(ID_RIVAL, ApiseVillage_Movement_RivalApproach)
	waitmovement(ID_RIVAL)

	// some something vaguely dumb or shitty
	msgbox(format("Let's battle you turd!"))
	closemessage

	// battle
	switch(var(VAR_STARTER_MON)) {
		case 0:
			trainerbattle_no_intro(TRAINER_APISEVILLAGE_RIVAL_CHIMCHAR, ApiseVillage_Text_RivalBattle_Lose)
		case 1:
			trainerbattle_no_intro(TRAINER_APISEVILLAGE_RIVAL_MUDKIP, ApiseVillage_Text_RivalBattle_Lose)
		case 2:
			trainerbattle_no_intro(TRAINER_APISEVILLAGE_RIVAL_BULBASAUR, ApiseVillage_Text_RivalBattle_Lose)
	}

	// say something salty
	msgbox(format("Blow me down, you shit me out!"))
	closemessage

	// leave
	applymovement(ID_RIVAL, ApiseVillage_Movement_RivalLeave)
	waitmovement(ID_RIVAL)

	// remove
	removeobject(ID_RIVAL)

	// set var
	setvar(VAR_APISE_RIVAL, 1)
	
	// set flag
	setflag(FLAG_APISEVILLAGE_RIVAL)

	release
	end
}

movement ApiseVillage_Movement_RivalSee {
	face_left
	emote_exclamation_mark
}

movement ApiseVillage_Movement_RivalApproach {
	walk_left * 2
}

movement ApiseVillage_Movement_RivalLeave {
	player_run_right * 7
}

text ApiseVillage_Text_RivalBattle_Lose {
    format("I can't believe it!")
}

// temp
script ApiseVillage_HoneyShopGuy {
	lock
	faceplayer

	msgbox(format("Hey there! Sorry the Honey Café (tm) is closed for now!"))
	closemessage

	release
	end
}

script ApiseVillage_SweetHeart {
	lock
	faceplayer

	if(flag(FLAG_APISEVILLAGE_SWEETHEART)) {
		msgbox(format("I hope her cat is well."))
		closemessage
	} else {
		msgbox(format("I've just had my heart broken, you might as well have this."))
		closemessage

		giveitem(ITEM_SWEET_HEART)

		setflag(FLAG_APISEVILLAGE_SWEETHEART)
	}

	release
	end
}