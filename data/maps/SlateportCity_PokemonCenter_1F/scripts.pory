
script ApiseVillage_PokemonCenter_1F_EventScript_Boy1 {
	lock
	faceplayer

	msgbox(format("I'm preparing my team to take on the honey café!"))
	closemessage

	release
	end
}

script ApiseVillage_PokemonCenter_1F_EventScript_Boy2 {
	lock
	faceplayer

	msgbox(format("What's the best held item to give to my Fletchling..."))
	closemessage

	release
	end
}

script ApiseVillage_PokemonCenter_1F_EventScript_Girl {
	lock
	faceplayer

	msgbox(format("I wonder what my legacy will be, who will remember me last?"))
	closemessage

	release
	end
}

raw `
.set LOCALID_NURSE, 1

SlateportCity_PokemonCenter_1F_MapScripts:: @ 820DABF
	map_script MAP_SCRIPT_ON_TRANSITION, SlateportCity_PokemonCenter_1F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0

SlateportCity_PokemonCenter_1F_OnTransition: @ 820DACA
	setrespawn HEAL_LOCATION_SLATEPORT_CITY
	call Common_EventScript_UpdateBrineyLocation
	end

SlateportCity_PokemonCenter_1F_EventScript_Nurse:: @ 820DAD3
	setvar VAR_0x800B, LOCALID_NURSE
	call Common_EventScript_PkmnCenterNurse
	waitmessage
	waitbuttonpress
	release
	end
