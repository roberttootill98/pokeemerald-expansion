mapscripts VenarusCove_FishermansClub_MapScripts {}

#region quiz

const ID_VENARUSCOVE_FISHERMANSCLUB_QUIZ_FISHERMAN = 1

script VenarusCove_FishermansClub_EventScript_QuizFisherman {
	lock
	faceplayer

	msgbox(
        format("I'm the host for the fisherman's quiz!\nIf you are successful you will be awarded with our prestigious fisherman's badge!"),
        MSGBOX_AUTOCLOSE
    )

    msgbox(format("Are you ready to take the quiz?"), MSGBOX_YESNO)
    
    if(var(VAR_RESULT) == 0) {
        call(VenarusCove_FishermansClub_EventScript_QuizFisherman_Failed)
        end
    }    

    playfanfare(MUS_OBTAIN_BADGE)
    applymovement(ID_VENARUSCOVE_FISHERMANSCLUB_QUIZ_FISHERMAN, VenarusCove_FishermansClub_Movement_QuizFisherman_Passed)
    waitmovement(ID_VENARUSCOVE_FISHERMANSCLUB_QUIZ_FISHERMAN)
    waitfanfare

    msgbox(format("Congratulations! You have passed the fisherman's quiz!"), MSGBOX_AUTOCLOSE)

    //#region leave
    msgbox(format("Your prize is in the backroom, follow me!"), MSGBOX_AUTOCLOSE)
    
    applymovement(ID_VENARUSCOVE_FISHERMANSCLUB_QUIZ_FISHERMAN, VenarusCove_FishermansClub_Movement_QuizFisherman_FaceUp)
    waitmovement(ID_VENARUSCOVE_FISHERMANSCLUB_QUIZ_FISHERMAN)

    opendoor(8, 4)
    waitdooranim

    delay(15)
    
    playse(SE_EXIT)
    removeobject(ID_VENARUSCOVE_FISHERMANSCLUB_QUIZ_FISHERMAN)
    waitse

    closedoor(8, 4)
    waitdooranim

    //#endregion leave

    setflag(FLAG_VENARUSCOVE_FISHERMANSCLUB_QUIZ_COMPLETE)

	release
	end
}

movement VenarusCove_FishermansClub_Movement_QuizFisherman_Passed {
    emote_exclamation_mark
}

movement VenarusCove_FishermansClub_Movement_QuizFisherman_FaceUp {
    face_up
}

script VenarusCove_FishermansClub_EventScript_QuizFisherman_Failed {
    playse(SE_BOO)
    applymovement(ID_VENARUSCOVE_FISHERMANSCLUB_QUIZ_FISHERMAN, VenarusCove_FishermansClub_Movement_QuizFisherman_Failed)
    waitmovement(ID_VENARUSCOVE_FISHERMANSCLUB_QUIZ_FISHERMAN)
    waitse

    msgbox(format("That is the wrong answer! You have failed the quiz!"), MSGBOX_AUTOCLOSE)

    msgbox(
        format("Please become more worldly and try our quiz again in five to ten years when you are ready!"),
        MSGBOX_AUTOCLOSE
    )

    release
}

movement VenarusCove_FishermansClub_Movement_QuizFisherman_Failed {
    emote_exclamation_mark
}

#endregion quiz
