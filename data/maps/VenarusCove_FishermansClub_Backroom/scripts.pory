mapscripts VenarusCove_FishermansClub_Backroom_MapScripts {}

script VenarusCove_FishermansClub_Backroom_EventScript_GetRod {
    lock

    finditem(ITEM_OLD_ROD)
    setflag(FLAG_VENARUSCOVE_GOT_FISHERMANS_BADGE)

    release
    end
}

script VenarusCove_FishermansClub_Backroom_EventScript_Fisherman {
    lock
    faceplayer

    msgbox(
        format("The fisherman's badge is the cheapest rod they sell. Sorry kid, we have to give out a lot of these."),
        MSGBOX_AUTOCLOSE
    )

    release
    end
}